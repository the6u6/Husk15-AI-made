<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).pairing.*</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).downloads.*</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).*</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Husk</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Android App</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.android.package-archive</string>
				<string>app.husk.xapk</string>
				<string>app.husk.apkm</string>
				<string>app.husk.apks</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>2.0.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>husk</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>112</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>stikjit</string>
		<string>stikdebug</string>
		<string>stosdebug</string>
		<string>apple-magnifier</string>
		<string>localdevvpn</string>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_remotepairing-pairable-host._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Husk uses the local network to pair with this iPhone for JIT, without a computer.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- iOS 14 and later read UILaunchScreen, below. iOS 13 has no other way to
	     know the app has a launch screen, and an app without one is not
	     eligible for the full screen on iPad: iPadOS treats it as a legacy app
	     and, with UIRequiresFullScreen false, will put it in one half of a Split
	     View or both. Both keys are kept for that reason. The em-dashes are
	     written as words because a double hyphen is not legal inside an XML
	     comment, and a plist that does not parse is a build that stops. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- True, and it was false upstream. Husk draws its own floating windows over
	     the tab UI, in AppWindows.swift, so two half-width copies of itself side
	     by side is not a layout it can present anything sensible into. The
	     launch storyboard above is what makes full screen *eligible* at iOS 13;
	     this is what asks for it. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Android App</string>
			<key>UTTypeIdentifier</key>
			<string>com.android.package-archive</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apk</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.android.package-archive</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Android App Bundle (XAPK)</string>
			<key>UTTypeIdentifier</key>
			<string>app.husk.xapk</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>xapk</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Android App Bundle (APKM)</string>
			<key>UTTypeIdentifier</key>
			<string>app.husk.apkm</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apkm</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Android App Bundle (APKS)</string>
			<key>UTTypeIdentifier</key>
			<string>app.husk.apks</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apks</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
