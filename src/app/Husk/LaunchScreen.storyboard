<?xml version="1.0" encoding="UTF-8"?>
<!--
  The launch screen iOS 13 needs, and why it is here at all.

  Info.plist has UILaunchScreen, the empty dictionary form, which is how an app
  declares its launch screen from iOS 14 onwards. iOS 13 does not read that key
  and has no other way to know: an app with no launch screen storyboard is not
  eligible for the full screen on iPad. iPadOS then treats it as a legacy app
  and may place it in one half of a Split View, or, because
  UIRequiresFullScreen was false, in both halves at once. The symptom is a
  screen divided in two with the same page and the same tab bar in each.

  So this exists to be found on 13. On 14 and later UILaunchScreen wins and this
  file is never shown; keeping both is the documented arrangement for a target
  that has to run on both.

  It is deliberately empty. A launch screen is a static image shown before the
  app runs, and Husk draws its own icon on the onboarding screen immediately
  afterwards, so putting anything here would show it twice.

  No double hyphens in this comment, which is a habit from writing commit
  messages and not a thing XML allows: it makes the file unparseable, and an
  unparseable storyboard is a build that stops with a column number rather than
  an explanation. tests/test_plist_and_storyboard_parse.py checks that.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="21507" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21505"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="414" height="896"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" red="0.0" green="0.0" blue="0.0" alpha="0" colorSpace="custom" customColorSpace="sRGB"/>
                        <viewLayoutGuide key="safeArea" id="6Tk-OE-BBY"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
</document>