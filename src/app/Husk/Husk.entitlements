<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets StikDebug attach to us as a debugger. Without this there is no JIT. -->
	<key>get-task-allow</key>
	<true/>
	<!-- Only honoured on TrollStore/jailbroken devices; harmless otherwise, and it
	     lets the same build skip the StikDebug dance where it IS honoured. -->
	<key>dynamic-codesigning</key>
	<true/>
	<!-- The native engines need real RAM on top of the host app's own footprint:
	     a Unity or Java runtime reserves its heap before anything is mapped. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Mappings past ~4 GB need this. An engine's reservation plus the JIT's
	     dual RW/RX mapping exceed that, and without it the large mapping is
	     simply refused. Husk does not depend on it being honoured: the address
	     space is probed at startup and the runtime is sized to whatever actually
	     maps. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
</dict>
</plist>
